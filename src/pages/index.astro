---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { site, experience, skills } from '../data/site';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{site.role} · {site.location}</p>
      <h1>
        I build event-driven systems and the products that run on them.
      </h1>
      <p class="lede">
        Ten years shipping production software, seven of them at Wayfair: Kafka order pipelines on GCP,
        internal platforms people rely on every day, and AI-powered tools built with Claude. I own
        things end to end, from the architecture diagram to the on-call fix.
      </p>
      <div class="actions">
        <a class="btn primary" href="#work">See my work</a>
        <a class="btn" href={site.resume}>Resume</a>
        <a class="btn" href={`mailto:${site.email}`}>Get in touch</a>
      </div>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2>Case studies</h2>
      </div>
      <div class="grid">
        {work.map((entry) => <WorkCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Experience</p>
        <h2>Where I've worked</h2>
      </div>
      <ol class="timeline">
        {
          experience.map((job) => (
            <li>
              <span class="period">{job.period}</span>
              <div>
                <h3>
                  {job.company} <span class="title">· {job.title}</span>
                </h3>
                <p>{job.blurb}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="skills">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Toolbox</p>
        <h2>What I work with</h2>
      </div>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items.map((i) => <span class="tag">{i}</span>)}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">About</p>
        <h2>Off the keyboard</h2>
      </div>
      <div class="about">
        <p>
          I live in Portsmouth, New Hampshire. When I'm not working I'm usually on a basketball court,
          on a trail, or scuba diving in the cold Atlantic. I also tinker with Raspberry Pi projects,
          like a bird feeder that identifies its visitors.
        </p>
        <p>
          I'm looking for a senior engineering role where I can own systems end to end and help a team
          ship faster. If that sounds like your team, <a href={`mailto:${site.email}`}>I'd love to talk</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { border-top: 0; padding: 6rem 0 5rem; }
  .hero h1 {
    font-size: clamp(2.4rem, 5.5vw, 4.25rem);
    max-width: 17ch;
    margin: 1rem 0 1.5rem;
  }
  .lede { font-size: 1.2rem; color: var(--muted); max-width: 60ch; margin: 0 0 2rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }

  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .timeline li:last-child { border-bottom: 0; }
  .period { font-family: var(--mono); font-size: 0.85rem; color: var(--muted); padding-top: 0.3rem; }
  .timeline h3 { font-size: 1.35rem; margin-bottom: 0.25rem; }
  .timeline .title { font-family: var(--sans); font-size: 1rem; color: var(--muted); font-weight: 400; }
  .timeline p { margin: 0; max-width: var(--measure); }

  .skills { margin: 0; display: grid; gap: 1rem; }
  .skills div { display: grid; grid-template-columns: 220px 1fr; gap: 2rem; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .about { margin-left: calc(220px + 2rem); max-width: var(--measure); }
  .about p:first-child { margin-top: 0; }

  @media (max-width: 760px) {
    .hero { padding: 3.5rem 0 3rem; }
    .timeline li, .skills div { grid-template-columns: 1fr; gap: 0.35rem; }
    .about { margin-left: 0; }
  }
</style>
